{
  "smoke": {
    "description": "Smoke test - minimal authenticated ticket-create traffic.",
    "thinkTimeSeconds": 1,
    "scenario": {
      "executor": "ramping-vus",
      "stages": [
        { "duration": "10s", "target": 1 },
        { "duration": "30s", "target": 5 },
        { "duration": "10s", "target": 0 }
      ]
    },
    "thresholds": {
      "checks": ["rate==1"],
      "dropped_iterations": ["count==0"],
      "http_req_failed": ["rate<0.01"],
      "http_req_duration": ["p(95)<1000"]
    }
  },
  "load": {
    "description": "Load test - sustained authenticated ticket-create traffic.",
    "thinkTimeSeconds": 0,
    "scenario": {
      "executor": "constant-arrival-rate",
      "duration": "5m",
      "rate": 5,
      "timeUnit": "1s",
      "preAllocatedVUs": 10,
      "maxVUs": 25
    },
    "thresholds": {
      "checks": ["rate==1"],
      "dropped_iterations": ["count==0"],
      "http_req_failed": ["rate<0.01"],
      "http_req_duration": ["p(95)<1000"]
    }
  },
  "stress": {
    "description": "Stress test - staged authenticated ticket-create traffic beyond the initial expected capacity.",
    "thinkTimeSeconds": 0,
    "scenario": {
      "executor": "ramping-arrival-rate",
      "startRate": 5,
      "timeUnit": "1s",
      "preAllocatedVUs": 25,
      "maxVUs": 100,
      "stages": [
        { "duration": "1m", "target": 5 },
        { "duration": "0s", "target": 10 },
        { "duration": "1m", "target": 10 },
        { "duration": "0s", "target": 20 },
        { "duration": "1m", "target": 20 },
        { "duration": "0s", "target": 40 },
        { "duration": "1m", "target": 40 }
      ]
    },
    "thresholds": {}
  }
}
